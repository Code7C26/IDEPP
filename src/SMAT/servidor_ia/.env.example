# Copiá este archivo como .env (el .env no se sube a GitHub)
# El robot y la cámara se encuentran por su nombre fijo, en cualquier WiFi: no hace falta cambiarlos.
# Solo si en algún WiFi no los encuentra por nombre, poné la IP que muestran en el Monitor Serie.
# También sirve un celular con la app IP Webcam: poné su dirección (http://<IP-del-celular>:8080/video).
URL_CAMARA=http://droid-camara.local/video
URL_ESP32_ALERTA=http://droid-robot.local/alerta_seguridad

# Conexión con la web. Si la IA corre en la MISMA PC que el backend, dejalas vacías.
# Si corre en otra PC: la IP de la PC del backend (con /api al final) y la clave que te pasa Tiziano por fuera de GitHub
DROID_URL=
YOLO_API_KEY=
# Opcional: zona fija (si no, la web usa la zona donde está el robot)
DROID_ZONA_ID=

# Puerto donde la IA reenvía el video a la web (en la web: http://<IP-de-esta-PC>:8080/video)
PUERTO_VIDEO=8080
